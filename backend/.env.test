# Test environment configuration
APP_NAME=VitaChain Backend
VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Module Configuration
MODULE=katara

# Database (test values)
DATABASE_URL=postgresql://postgres:test@localhost:5432/test_vitachain
SUPABASE_URL=https://test.supabase.co
SUPABASE_JWT_SECRET=test-jwt-secret

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# External APIs (test values)
ANTHROPIC_API_KEY=test-anthropic-key
OPENWEATHER_API_KEY=test-openweather-key
BREVO_API_KEY=test-brevo-key

# Frontend
FRONTEND_URL=http://localhost:3000

# Monitoring
ENABLE_METRICS=true
METRICS_INTERVAL=60
HEALTH_CHECK_INTERVAL=30

# Performance Thresholds
API_RESPONSE_TIME_THRESHOLD=500
MEMORY_USAGE_THRESHOLD=80
CPU_USAGE_THRESHOLD=80
DISK_USAGE_THRESHOLD=85

# Cache Configuration
WEATHER_CACHE_TTL=900
SATELLITE_CACHE_TTL=86400
DEFAULT_CACHE_TTL=3600
