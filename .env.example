# ================================
# External API Keys
# ================================
# Anthropic Claude API for AI recommendations
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Brevo (Sendinblue) for email notifications
BREVO_API_KEY=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

# OpenWeatherMap for weather data
OPENWEATHER_API_KEY=your-openweather-api-key

# ================================
# Security Settings
# ================================
# JWT settings
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# API rate limiting
API_RATE_LIMIT=100
TELEMETRY_RATE_LIMIT=1000

# SSL Configuration
SSL_CERT_PATH=/etc/letsencrypt/live/vitachain.ma/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/vitachain.ma/privkey.pem
SSL_AUTO_RENEWAL=true

# API Key Configuration
IOT_API_KEY=vitachain-[generated-key]
API_KEY_ROTATION_ENABLED=true
API_KEY_ROTATION_DAYS=90

# Security Monitoring
SECURITY_LOG_LEVEL=INFO
SECURITY_ALERT_EMAIL=admin@vitachain.ma
FAILED_AUTH_THRESHOLD=5
RATE_LIMIT_ALERT_THRESHOLD=100

# Firewall Configuration
FIREWALL_ENABLED=true
SSH_ALLOWED_IPS=

# ================================
# SSL Configuration
# ================================
# SSL certificate paths (usually handled by Let's Encrypt)
SSL_CERT_PATH=/etc/ssl/certs/vitachain.ma.crt
SSL_KEY_PATH=/etc/ssl/certs/vitachain.ma.key

# ================================
# Database Settings
# ================================
# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# ================================
# Redis Settings (for caching)
# ================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ================================
# Monitoring & Logging
# ================================
# Application monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging configuration
LOG_FORMAT=json
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# ================================
# Development Settings
# ================================
# Only for development environment
DEV_MODE=false
DEBUG=false
HOT_RELOAD=false

# ================================
# IoT Configuration
# ================================
# ESP32 device settings
IOT_API_KEY=your-iot-api-key-here
IOT_API_KEY_ROTATION_DAYS=90
IOT_DEVICE_TIMEOUT=300

# ================================
# Email Configuration
# ================================
# Brevo email settings
EMAIL_FROM=noreply@vitachain.ma
EMAIL_REPLY_TO=support@vitachain.ma

# ================================
# File Upload Settings
# ================================
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,csv

# ================================
# Backup Settings
# ================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=vitachain-backups

# ================================
# Performance Settings
# ================================
# Connection timeouts
HTTP_TIMEOUT=30
DATABASE_TIMEOUT=10
EXTERNAL_API_TIMEOUT=30

# ================================
# Infrastructure Services Configuration
# ================================
# Redis caching
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Monitoring and metrics
ENABLE_METRICS=true
METRICS_INTERVAL=60
HEALTH_CHECK_INTERVAL=30

# Performance thresholds
API_RESPONSE_TIME_THRESHOLD=500
MEMORY_USAGE_THRESHOLD=80
CPU_USAGE_THRESHOLD=80
DISK_USAGE_THRESHOLD=85

# Cache TTL settings
WEATHER_CACHE_TTL=900
SATELLITE_CACHE_TTL=86400
DEFAULT_CACHE_TTL=3600

# Cache settings
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400
