SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inltb2dvZW11enF5anNkamh6cG56Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODMxODcyNiwiZXhwIjoyMDkzODk0NzI2fQ.R4bQF2C0t4sRAjpI1vocoPvGkhpdb0OM_IBypMupccQ

